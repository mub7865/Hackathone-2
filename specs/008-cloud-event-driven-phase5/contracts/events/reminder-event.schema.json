{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://calm-orbit-todo.example.com/schemas/reminder-event.v1.json",
  "title": "Reminder Event",
  "description": "Event published when a task reminder should be sent to the user",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "timestamp",
    "correlation_id",
    "user_id",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version for backward compatibility",
      "enum": ["1.0"],
      "example": "1.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this event (for idempotency)",
      "example": "123e4567-e89b-12d3-a456-426614174000"
    },
    "event_type": {
      "type": "string",
      "description": "Type of reminder event",
      "enum": ["reminder.triggered"],
      "example": "reminder.triggered"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the event occurred (UTC)",
      "example": "2026-01-11T10:30:00Z"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "description": "Correlation ID for distributed tracing",
      "example": "987fcdeb-51a2-43d7-9876-543210fedcba"
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "ID of the user who should receive the reminder",
      "example": "user-123e4567-e89b-12d3-a456-426614174000"
    },
    "payload": {
      "type": "object",
      "description": "Reminder-specific payload",
      "required": [
        "task_id",
        "title",
        "due_date",
        "remind_at",
        "time_until_due"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "format": "uuid",
          "description": "ID of the task",
          "example": "task-123e4567-e89b-12d3-a456-426614174000"
        },
        "title": {
          "type": "string",
          "description": "Task title",
          "maxLength": 255,
          "example": "Daily standup meeting"
        },
        "description": {
          "type": ["string", "null"],
          "description": "Task description",
          "example": "Team sync at 9 AM"
        },
        "priority": {
          "type": "string",
          "description": "Task priority level",
          "enum": ["high", "medium", "low"],
          "example": "high"
        },
        "tags": {
          "type": "array",
          "description": "Array of tag strings",
          "items": {
            "type": "string"
          },
          "example": ["work", "meetings"]
        },
        "due_date": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp for task due date (UTC)",
          "example": "2026-01-12T09:00:00Z"
        },
        "remind_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp for reminder notification (UTC)",
          "example": "2026-01-12T08:45:00Z"
        },
        "time_until_due": {
          "type": "string",
          "description": "Human-readable time until due date (e.g., '15 minutes', '1 hour', '1 day')",
          "example": "15 minutes"
        },
        "notification_channels": {
          "type": "array",
          "description": "Channels to send notification through (based on user preferences)",
          "items": {
            "type": "string",
            "enum": ["email", "inapp"]
          },
          "minItems": 1,
          "example": ["email", "inapp"]
        },
        "user_email": {
          "type": ["string", "null"],
          "format": "email",
          "description": "User's email address (if email notification enabled)",
          "example": "user@example.com"
        },
        "user_timezone": {
          "type": "string",
          "description": "User's timezone (IANA format)",
          "example": "America/New_York"
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": "1.0",
      "event_id": "evt-reminder-123e4567-e89b-12d3-a456-426614174000",
      "event_type": "reminder.triggered",
      "timestamp": "2026-01-12T08:45:00Z",
      "correlation_id": "corr-987fcdeb-51a2-43d7-9876-543210fedcba",
      "user_id": "user-123e4567-e89b-12d3-a456-426614174000",
      "payload": {
        "task_id": "task-123e4567-e89b-12d3-a456-426614174000",
        "title": "Daily standup meeting",
        "description": "Team sync at 9 AM",
        "priority": "high",
        "tags": ["work", "meetings"],
        "due_date": "2026-01-12T09:00:00Z",
        "remind_at": "2026-01-12T08:45:00Z",
        "time_until_due": "15 minutes",
        "notification_channels": ["email", "inapp"],
        "user_email": "user@example.com",
        "user_timezone": "America/New_York"
      }
    }
  ]
}
