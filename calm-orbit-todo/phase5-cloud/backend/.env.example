# Application Configuration
APP_NAME="Phase 5: Cloud-Native Event-Driven Todo"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (Neon Postgres)
DATABASE_URL=postgresql+asyncpg://username:password@your-neon-host.neon.tech:5432/todo_db?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Dapr Configuration
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_PUBSUB_NAME=pubsub-kafka
DAPR_STATE_STORE_NAME=state-postgresql

# Kafka/Redpanda Configuration
KAFKA_BOOTSTRAP_SERVERS=your-redpanda-cluster.redpanda.com:9092
KAFKA_TOPIC_TASK_EVENTS=task-events
KAFKA_TOPIC_REMINDERS=reminders
KAFKA_TOPIC_TASK_UPDATES=task-updates
KAFKA_CONSUMER_GROUP=phase5-backend

# SendGrid Configuration
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Todo App

# OpenAI Configuration (from Phase III)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# CORS Configuration (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com

# Logging
LOG_LEVEL=INFO

# Feature Flags
ENABLE_EVENT_PUBLISHING=true
ENABLE_NOTIFICATIONS=true
ENABLE_AUDIT_LOGGING=true
 