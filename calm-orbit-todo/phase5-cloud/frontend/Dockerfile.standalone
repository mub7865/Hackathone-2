# ============================================
# Standalone Dockerfile - Uses pre-built output
# ============================================
FROM node:22-alpine

# Set working directory
WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -u 1001 -S -D -H -G nodejs nodejs

# Copy pre-built standalone output
COPY --chown=nodejs:nodejs .next/standalone ./
COPY --chown=nodejs:nodejs .next/static ./.next/static

# Switch to non-root user
USER nodejs

# Expose application port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --spider -q --tries=1 http://localhost:3000/ || exit 1

# Start Next.js server
CMD ["node", "server.js"]
